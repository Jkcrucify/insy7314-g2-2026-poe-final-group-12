# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules
.pnp
.pnp.js

# -----------------------------------------------------------------------------
# Environment Variables (CRITICAL FOR SECURITY)
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# SSL private keys / certificates (generate locally, never commit)
certs/
*.key
*.pem

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs
.log

npm-debug.log
yarn-debug.log
yarn-error.log

# Logs captured from a real container run are committed as assessment evidence.
# Without these negations the 'logs' rule above would silently swallow the folder.
!evidence/**/logs/
!evidence/**/logs/**

# -----------------------------------------------------------------------------
# Production Builds & Coverage
# -----------------------------------------------------------------------------
build
dist
coverage
client/test-report
.next
out

# -----------------------------------------------------------------------------
# OS & Editor Files (To keep the repo clean of personal system files)
# -----------------------------------------------------------------------------
.DS_Store
.vscode
.idea
.suo
.ntvs
.njsproj
.sln
.sw

# Jest temporary log output
api/tests/.tmp-logs
api/tests/reports/coverage
