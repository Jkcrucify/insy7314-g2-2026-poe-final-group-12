# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5001
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
# MongoDB Atlas connection string (include the database name, e.g. /hustlehub)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hustlehub?retryWrites=true&w=majority
# Origin of the React frontend (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
# Optional rate-limit overrides (requests per 15 minutes)
AUTH_RATE_LIMIT_MAX=20
BOOKING_RATE_LIMIT_MAX=10

# Account lockout: consecutive failed logins before an account is locked, and for how long
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Optional: Grafana Cloud Loki (logs are also kept locally). Leave blank to disable.
# Grafana Cloud -> your stack -> Loki -> Details: URL, User, and an access-policy token with logs:write
LOKI_HOST=
LOKI_USER=
LOKI_TOKEN=
