{
  "name": "api",
  "version": "2.0.0",
  "description": "HustleHub+ secure marketplace API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o tests/reports/eslint-report.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:api": "newman run tests/postman/HustleHub.postman_collection.json --insecure --folder \"1 Auth\" --folder \"2 Gigs\" --folder \"3 Bookings and Transactions\" --folder \"4 Security\" --folder \"6 Tax, Lockout and Revocation\" -r cli,htmlextra --reporter-htmlextra-export tests/reports/newman-report.html",
    "test:ratelimit": "newman run tests/postman/HustleHub.postman_collection.json --insecure --folder \"5 Rate Limiting\" -r cli,htmlextra --reporter-htmlextra-export tests/reports/newman-ratelimit-report.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.16.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
